    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/validator": "^13.15.10",
    "baseline-browser-mapping": "^2.9.4",
    "cross-env": "^10.1.0",
